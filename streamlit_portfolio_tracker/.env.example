# Application
APP_NAME=Portfolio Tracker
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///data/portfolio.db
# For PostgreSQL: postgresql://user:password@localhost:5432/portfolio_db

# Email Service (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@portfolio-tracker.com
REPLY_TO_EMAIL=support@portfolio-tracker.com

# Market Data
ENABLE_LIVE_PRICES=True
PRICE_UPDATE_INTERVAL=300  # seconds

# Background Jobs
ENABLE_SCHEDULER=True
SNAPSHOT_CRON=0 0 1 * *  # 1st of month at midnight
PE_UPDATE_CRON=0 9 * * *  # Daily at 9 AM
ALERT_CHECK_CRON=0 10 * * *  # Daily at 10 AM

# Security
SESSION_TIMEOUT=3600  # seconds
PASSWORD_MIN_LENGTH=6
BCRYPT_ROUNDS=12

# API Keys (Optional)
NSE_API_KEY=your_nse_api_key
YAHOO_FINANCE_ENABLED=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
ERROR_LOG_FILE=logs/error.log

# Features
ENABLE_EMAIL_ALERTS=True
ENABLE_AUTO_SIP=False
ENABLE_TAX_HARVESTING=True